{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["jest"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*":            ["./*"],
      "@tests/*":       ["./tests/*"],
      "@prisma/*":      ["./prisma/*"],
      "@public/*":      ["./public/*"],
      "@avatars/*":     ["./public/avatars/*"],
      "@covers/":       ["./public/bookcovers/*"],
      "@images/*":      ["./public/images/*"],
      "@upload/*":      ["./public/upload/*"],
      
      "@src/":            ["./src/*"],
      "@app/*":           ["./src/app/*"],
      "@api/*":           ["./src/app/api/*"],
      "@styles/*":        ["./src/styles/*"],
      "@components/*":    ["./src/components/*"],
      
      "@models/*":        ["./src/models/*"],
      "@includes/*":      ["./src/includes/*"],
      "@repositories/*":  ["./src/repositories/*"],
      "@services/*":      ["./src/services/*"],
      "@routes/*":        ["./src/app/api/*"],
      "@clients/*":       ["./src/clients/*"],
      "@hooks/*":         ["./src/hooks/*"],

      "@libs/*":          ["./src/libs/*"],
      "@contexts/*":      ["./src/contexts/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules"]
}
