{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "esnext"],
    "types": ["vitest"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*":              ["./*"],
      "@tests/*":         ["./tests/*"],
      "@prisma/*":        ["./prisma/*"],


      // src/
      "@app/*":           ["./src/app/*"],
      "@clients/*":       ["./src/clients/*"],
      "@components/*":    ["./src/components/*"],
      "@contexts/*":      ["./src/contexts/*"],
      "@hooks/*":         ["./src/hooks/*"],
      "@includes/*":      ["./src/includes/*"],
      "@libs/*":          ["./src/libs/*"],
      "@models/*":        ["./src/models/*"],
      "@repositories/*":  ["./src/repositories/*"],


      "@api/*":           ["./src/app/api/*"],
      "@styles/*":        ["./src/styles/*"],
      "@services/*":      ["./src/services/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules"]
}
