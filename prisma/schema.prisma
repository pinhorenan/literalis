datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
}

enum ShelfStatus {
  TO_READ
  READING
  READ
  ABANDONED
}

model User {
  username  String @id
  name      String
  email     String @unique
  avatarUrl String @default("/uploads/avatars/default.jpg")
  bio       String @default("Esse usuário ainda não escreveu uma bio")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts        Post[]
  comments     Comment[]
  postLikes    PostLike[]    @relation("UserPostLikes")
  commentLikes CommentLike[] @relation("UserCommentLikes")

  followers Follow[] @relation("Following")
  following Follow[] @relation("Followers")

  bookshelf UserBook[]

  notificationsSent     Notification[] @relation("NotificationActor")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  Account               Account[]
}

model Book {
  isbn            String    @id
  title           String
  author          String
  publisher       String    @default("Editora desconhecida")
  edition         Int       @default(1)
  pages           Int       @default(9999)
  language        String    @default("Idioma desconhecido")
  publicationDate DateTime  @default(now())
  coverUrl        String    @default("/uploads/covers/default.jpg")
  external        Boolean   @default(false)

  posts     Post[]
  inShelves UserBook[]
}

model UserBook {
  userUsername String
  bookIsbn     String

  currentPage Int         @default(0)
  rating      Int?
  status      ShelfStatus @default(TO_READ)
  isPrivate   Boolean     @default(false)

  addedAt   DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  removedAt DateTime?

  user  User   @relation(fields: [userUsername], references: [username], onDelete: Cascade)
  book  Book   @relation(fields: [bookIsbn], references: [isbn], onDelete: Cascade)
  posts Post[]

  @@id([userUsername, bookIsbn])
}

model Post {
  id        String   @id @default(cuid())
  content   String   @default("")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userUsername String
  bookIsbn     String
  userBook     UserBook @relation(fields: [userUsername, bookIsbn], references: [userUsername, bookIsbn], onDelete: Cascade)

  likes         PostLike[]     @relation("PostLikes")
  comments      Comment[]
  notifications Notification[] @relation("PostNotifications")
  User          User           @relation(fields: [userUsername], references: [username])
  Book          Book           @relation(fields: [bookIsbn], references: [isbn])

  @@index([userUsername, bookIsbn])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId         String
  authorUsername String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUsername], references: [username], onDelete: Cascade)

  likes         CommentLike[]
  notifications Notification[] @relation("CommentNotifications")
}

model PostLike {
  userUsername String
  postId       String
  createdAt    DateTime @default(now())

  user User @relation("UserPostLikes", fields: [userUsername], references: [username], onDelete: Cascade)
  post Post @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)

  @@id([userUsername, postId])
}

model CommentLike {
  userUsername String
  commentId    String
  createdAt    DateTime @default(now())

  user    User    @relation("UserCommentLikes", fields: [userUsername], references: [username], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userUsername, commentId])
}

model Follow {
  followerUsername String
  followedUsername String
  createdAt        DateTime @default(now())

  follower User @relation("Following", fields: [followerUsername], references: [username], onDelete: Cascade)
  followed User @relation("Followers", fields: [followedUsername], references: [username], onDelete: Cascade)

  @@id([followerUsername, followedUsername])
}

model Notification {
  id        String           @id @default(cuid())
  notifType NotificationType
  createdAt DateTime         @default(now())
  readAt    DateTime?

  recipientUsername String
  actorUsername     String
  postId            String?
  commentId         String?

  recipient User     @relation("NotificationRecipient", fields: [recipientUsername], references: [username], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorUsername], references: [username], onDelete: Cascade)
  post      Post?    @relation("PostNotifications", fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation("CommentNotifications", fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientUsername])
}

model Account {
  id                String   @id @default(cuid())
  userUsername      String
  provider          String
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userUsername], references: [username], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
